<!DOCTYPE html>
<html lang="en" data-theme="{{.Theme}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{if .RefreshSeconds}}<meta http-equiv="refresh" content="{{.RefreshSeconds}}">{{end}}
  <title>{{.Title}}</title>
  <style>{{.CSS}}</style>
</head>
<body>
  <div class="dashboard-header">
    <h1>{{.Title}}</h1>
    {{if .GeneratedAt}}<div class="generated">Generated {{.GeneratedAt}}</div>{{end}}
  </div>
  {{range .Groups}}
  <div class="group">
    <div class="group-header">{{.Name}}</div>
    <div class="tiles">
      {{range .Tiles}}
      {{if .Link}}<a class="tile" href="{{.Link}}" target="_blank" rel="noopener">{{else}}<div class="tile">{{end}}
        {{if .HasIcon}}
        {{if .IconData}}
        <img class="tile-icon" src="{{.IconData}}" alt="{{.Name}}">
        {{else}}
        <div class="tile-icon-placeholder">{{firstChar .Name}}</div>
        {{end}}
        {{end}}
        <div class="tile-name">{{.Name}}</div>
        {{if .Slots}}
        <div class="tile-slots">
          {{range .Slots}}
          <div class="slot" {{if .Output}}data-tooltip="{{.Output}}"{{end}}>
            <span class="slot-label">{{.Label}}</span>
            <span class="slot-name">{{.Name}}</span>
          </div>
          {{end}}
        </div>
        {{end}}
        {{if .BannerURI}}
        <div class="tile-banner">
          <img src="{{.BannerURI}}" alt="{{.Name}}" class="banner-img">
        </div>
        {{end}}
      {{if .Link}}</a>{{else}}</div>{{end}}
      {{end}}
    </div>
  </div>
  {{end}}
  <footer class="dashboard-footer">
    Generated by <a href="https://github.com/halfdane/ilias" target="_blank" rel="noopener">ilias</a> {{.Version}}
  </footer>
  <script>
    (function() {
      var overlay;
      function removePopout() {
        var img = document.querySelector('.banner-img.popout');
        if (img) img.classList.remove('popout');
        if (overlay) {
          overlay.remove();
          overlay = null;
        }
      }
      document.querySelectorAll('.banner-img').forEach(function(img) {
        img.addEventListener('click', function(e) {
          e.stopPropagation();
          e.preventDefault();
          var isPopout = img.classList.toggle('popout');
          if (isPopout) {
            overlay = document.createElement('div');
            overlay.className = 'banner-popout-overlay';
            document.body.appendChild(overlay);
          } else {
            if (overlay) {
              overlay.remove();
              overlay = null;
            }
          }
        });
      });
      document.addEventListener('click', function() {
        removePopout();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' || e.key === 'Esc') {
          removePopout();
        }
      });
    })();
  </script>
</body>
</html>
